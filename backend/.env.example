# Host ON (AI) 백엔드 환경변수 예시 — 실제 값은 .env에 두고 커밋하지 않는다
DATABASE_URL=postgresql+asyncpg://hoston:hoston_local_dev@localhost:5432/host_on_ai
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:5173

# 실행 환경 — development일 때만 인증 스텁이 동작한다(app/core/dependencies.py)
ENV=development
# 9/11 인증 구현 전까지 쓰는 개발용 host_id. 배포본에는 설정하지 않는다.
DEV_AUTH_HOST_ID=1
