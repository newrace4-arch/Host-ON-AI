{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* 절대 경로 @/ → src/ (vite.config.ts의 resolve.alias와 쌍으로 유지) */
    /* TS6에서 baseUrl은 deprecated. paths만 두면 tsconfig 위치 기준으로
       해석되므로 baseUrl 없이 동작한다. */
    "paths": { "@/*": ["./src/*"] },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type checking — 9/8 추가.
       템플릿 기본값에 strict가 없어 number와 number|null을 구분하지 못했다.
       api_contract v2.0의 conflict_count가 nullable이라 반드시 필요하다. */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
